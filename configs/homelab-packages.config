# ============================================================
# Homelab extras for BPI-R4 Pro 8X
# Base: woziwrt/pro-8x-unifi
# Target: Patryk-S-W/bpi-r4-deploy homelab-pro-8x
# ============================================================


# ============================================================
# DNS / filtering
# ============================================================

CONFIG_PACKAGE_adguardhome=y

CONFIG_PACKAGE_unbound-daemon=y
CONFIG_PACKAGE_unbound-control=y
CONFIG_PACKAGE_unbound-control-setup=y
CONFIG_PACKAGE_unbound-checkconf=y
CONFIG_PACKAGE_unbound-anchor=y
CONFIG_PACKAGE_unbound-host=y
CONFIG_PACKAGE_luci-app-unbound=y


# ============================================================
# WireGuard / AmneziaWG / policy routing
# ============================================================

CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y

CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_resolveip=y


# ============================================================
# Multi-WAN / failover
# ============================================================

CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y


# ============================================================
# nftables / firewall / flow offload / conntrack
# ============================================================

CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fib=y

CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_conntrack-tools=y


# ============================================================
# TL-WN722N v1 / AR9271 / ath9k_htc
# ============================================================

CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

CONFIG_PACKAGE_kmod-ath=y
CONFIG_PACKAGE_kmod-ath9k-common=y
CONFIG_PACKAGE_kmod-ath9k-htc=y
CONFIG_PACKAGE_ath9k-htc-firmware=y

# CONFIG_PACKAGE_kmod-ath9k is not set

CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_wavemon=y


# ============================================================
# Kismet / Wi-Fi monitoring
# ============================================================

CONFIG_PACKAGE_kismet=y
CONFIG_PACKAGE_kismet-capture-linux-wifi=y

CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_tcpdump=y


# ============================================================
# Docker / Dockge-ready
# ============================================================

CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y

CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_cgroupfs-mount=y

CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y


# ============================================================
# NVMe / block devices / filesystems
# ============================================================

CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_nvme-cli=y

CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y

CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_ntfs-3g=y

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y


# ============================================================
# USB storage / useful USB support
# ============================================================

CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y


# ============================================================
# Reverse proxy / local services
# ============================================================

CONFIG_PACKAGE_nginx-full=y
CONFIG_PACKAGE_nginx-ssl-util=y


# ============================================================
# Privacy / proxy lab
# ============================================================

CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_xray-example=y

CONFIG_PACKAGE_tor=y
CONFIG_PACKAGE_tor-geoip=y

CONFIG_PACKAGE_i2pd=y
CONFIG_PACKAGE_luci-app-i2pd=y


# ============================================================
# Phone cluster support
# ============================================================

CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-sftp-client=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_sshpass=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_tmux=y

CONFIG_PACKAGE_avahi-daemon=y
CONFIG_PACKAGE_avahi-utils=y


# ============================================================
# SQM / QoS
# ============================================================

CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y

CONFIG_PACKAGE_qosify=y
CONFIG_PACKAGE_luci-app-qosify=y


# ============================================================
# Diagnostics / debugging / network tools
# ============================================================

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_bash=y

CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_mtr-json=y
CONFIG_PACKAGE_nmap-ncat=y
CONFIG_PACKAGE_drill=y
CONFIG_PACKAGE_bind-dig=y

CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-tracepath=y
CONFIG_PACKAGE_traceroute=y

CONFIG_PACKAGE_logrotate=y


# ============================================================
# LuCI convenience
# ============================================================

CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-statistics=y


# ============================================================
# DO NOT ADD: known problematic on your setup
# ============================================================

